{
  "name": "skreenmaker",
  "version": "1.0.0",
  "scripts": {
    "build": "vite build && node -e \"const fs=require('fs'); fs.copyFileSync('static/app.css','static/dist/app.css'); fs.writeFileSync('static/dist/vue-flow.css', fs.readFileSync('node_modules/@vue-flow/core/dist/style.css','utf8')+'\\n'+fs.readFileSync('node_modules/@vue-flow/core/dist/theme-default.css','utf8'));\"",
    "start": "python -m src.interactive_tui",
    "api": "python -m src.server",
    "api:dev": "uvicorn src.server:app --host 0.0.0.0 --port 8000 --reload",
    "agent": "python -m src.main",
    "step": "python -m src.interactive_step",
    "test": "pytest tests/ -v"
  },
  "dependencies": {
    "@vue-flow/background": "1.3.2",
    "@vue-flow/controls": "1.1.2",
    "@vue-flow/core": "1.41.0",
    "@vue-flow/minimap": "1.5.2",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "vite": "^8.0.11"
  }
}
