    {"id": "parser", "type": "rectangle", "x": 680, "y": 230, "width": 160, "height": 50, "label": {"text": "Page Parser\n(title, h1-h3, links)"}, "backgroundColor": "#e8f5e9", "strokeColor": "#388e3c"},

    {"id": "agent", "type": "rectangle", "x": 120, "y": 330, "width": 160, "height": 50, "label": {"text": "Agent Loop\n(observe → think → act)"}, "backgroundColor": "#fce4ec", "strokeColor": "#c2185b"},
    {"id": "server", "type": "rectangle", "x": 320, "y": 330, "width": 180, "height": 50, "label": {"text": "FastAPI Server\n(/act /screenshot)"}, "backgroundColor": "#fce4ec", "strokeColor": "#c2185b"},
    {"id": "interactive", "type": "rectangle", "x": 540, "y": 330, "width": 180, "height": 50, "label": {"text": "Interactive Step\n(storage_state.json)"}, "backgroundColor": "#fce4ec", "strokeColor": "#c2185b"},

    {"id": "openai", "type": "rectangle", "x": 50, "y": 430, "width": 160, "height": 50, "label": {"text": "OpenAI GPT-4o"}, "backgroundColor": "#f3e5f5", "strokeColor": "#7b1fa2"},
    {"id": "ollama", "type": "rectangle", "x": 280, "y": 430, "width": 160, "height": 50, "label": {"text": "Ollama (local)\nllava / moondream"}, "backgroundColor": "#f3e5f5", "strokeColor": "#7b1fa2"},
    {"id": "anthropic", "type": "rectangle", "x": 510, "y": 430, "width": 170, "height": 50, "label": {"text": "Anthropic Claude"}, "backgroundColor": "#f3e5f5", "strokeColor": "#7b1fa2"},

    {"id": "shots", "type": "rectangle", "x": 50, "y": 530, "width": 150, "height": 50, "label": {"text": "Screenshots\nstep_N.jpg"}, "backgroundColor": "#e0f7fa", "strokeColor": "#0097a7"},
    {"id": "state", "type": "rectangle", "x": 280, "y": 530, "width": 170, "height": 50, "label": {"text": "agent_state.json\n(resume)"}, "backgroundColor": "#e0f7fa", "strokeColor": "#0097a7"},
