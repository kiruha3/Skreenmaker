{
  "elements": [
    {"id": "cli-main", "type": "rectangle", "x": 50, "y": 30, "width": 140, "height": 50, "label": {"text": "CLI Main\n(--url --task)"}, "backgroundColor": "#e3f2fd", "strokeColor": "#1976d2"},
    {"id": "cli-step", "type": "rectangle", "x": 280, "y": 30, "width": 180, "height": 50, "label": {"text": "CLI Interactive Step\n(--history)"}, "backgroundColor": "#e3f2fd", "strokeColor": "#1976d2"},
    {"id": "web-tui", "type": "rectangle", "x": 530, "y": 30, "width": 150, "height": 50, "label": {"text": "Web TUI\n(localhost:8080)"}, "backgroundColor": "#e3f2fd", "strokeColor": "#1976d2"},

    {"id": "browser", "type": "rectangle", "x": 300, "y": 130, "width": 220, "height": 60, "label": {"text": "BrowserController\n(Playwright + Chromium)"}, "backgroundColor": "#fff3e0", "strokeColor": "#f57c00"},

    {"id": "tracker", "type": "rectangle", "x": 30, "y": 230, "width": 180, "height": 50, "label": {"text": "Element Tracker\n(stable hashes + dedup)"}, "backgroundColor": "#e8f5e9", "strokeColor": "#388e3c"},
    {"id": "overlay", "type": "rectangle", "x": 260, "y": 230, "width": 170, "height": 50, "label": {"text": "Overlay Engine\n(colored IDs)"}, "backgroundColor": "#e8f5e9", "strokeColor": "#388e3c"},
