    {"type": "arrow", "x": 0, "y": 0, "start": {"id": "anthropic"}, "end": {"id": "agent"}, "strokeColor": "#999", "strokeStyle": "dashed"},

    {"type": "arrow", "x": 0, "y": 0, "start": {"id": "agent"}, "end": {"id": "shots"}, "strokeColor": "#555"},
    {"type": "arrow", "x": 0, "y": 0, "start": {"id": "agent"}, "end": {"id": "state"}, "strokeColor": "#555"},
