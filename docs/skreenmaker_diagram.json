    {"type": "arrow", "x": 0, "y": 0, "start": {"id": "overlay"}, "end": {"id": "interactive"}, "strokeColor": "#555"},
    {"type": "arrow", "x": 0, "y": 0, "start": {"id": "parser"}, "end": {"id": "agent"}, "strokeColor": "#555"},

    {"type": "arrow", "x": 0, "y": 0, "start": {"id": "agent"}, "end": {"id": "openai"}, "strokeColor": "#555"},
