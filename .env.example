# LLM Provider Settings
LLM_PROVIDER=openai
API_KEY=sk-your-key-here
MODEL=gpt-4o
# BASE_URL=https://api.openai.com/v1

# Alternative providers (uncomment one):
# LLM_PROVIDER=anthropic
# API_KEY=sk-ant-your-key-here
